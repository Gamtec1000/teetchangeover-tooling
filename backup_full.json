  "changeover_templates": [
    {
      "id": "nQxxKfZJOMlE7aIPJRjd",
      "documents": [],
      "pipeSize": "4\" 1/2",
      "machineId": "MKsBpj3PpveSILkZ0UcI",
      "estimatedTime": 45,
      "steps": [
        {
          "id": "0Hr5R1eGEV9JQKZajfgV",
          "imageUrls": [
            "http://172.20.10.2:3001/uploads/1764326008278-646297461",
            "http://172.20.10.2:3001/uploads/1764326008290-574344711.png"
          ],
          "order": 7,
          "description": "• For small diameters: The clamping angle should be 135° ± 15° or 45° ± 15°.\n• For all other sizes: Adjust the angle to approximately 90° to minimize die penetration.\n• If coupling slippage occurs, increase the angle to 110° or 135° for greater clamping\nforce.",
          "partIds": [],
          "toolIds": [],
          "title": "Clamping Angle Adjustments"
        },
        {
          "id": "11vd3VB02RLLWSOyLOcj",
          "description": "• Close the gate.\n• Switch the manual mode back to AUTO mode on the control panel.",
          "imageUrls": [],
          "order": 11,
          "toolIds": [],
          "partIds": [],
          "title": "Final Setup and Activation"
        },
        {
          "id": "TwdJ1567k6qVYQ37K9En",
          "description": "Install the New Drift:\n• Secure the new drift shaft by tightening it clockwise.\n• Adjust the drift table height to align with the pipe centerline.\n• On the Touch Panel, move the drift forward to the coupling to verify alignment.",
          "partIds": [],
          "title": "Drift Change",
          "imageUrls": [
            "http://172.20.10.2:3001/uploads/1764326369376-385306209.png",
            "http://172.20.10.2:3001/uploads/1764326369389-4921825.png",
            "http://172.20.10.2:3001/uploads/1764326369400-158242499",
            "http://172.20.10.2:3001/uploads/1764326369410-369910773"
          ],
          "order": 10,
          "toolIds": []
        },
        {
          "id": "V4LXjKho0lIlY8sFyXmO",
          "toolIds": [],
          "order": 4,
          "title": "Mechanical Adjustments",
          "partIds": [],
          "imageUrls": [
            "http://172.20.10.2:3001/uploads/1764325772313-209306313",
            "http://172.20.10.2:3001/uploads/1764325772322-417805625"
          ],
          "description": "Before starting a job, adjust the rotary head centricity based on the pipe diameter.\nSet the clamping path as per Table 4.3 before installing the clamping jaws."
        },
        {
          "id": "bdpUY9QA2BAmk88gjlmT",
          "imageUrls": [
            "http://172.20.10.2:3001/uploads/1764326257382-129674815"
          ],
          "order": 9,
          "toolIds": [],
          "partIds": [],
          "title": "Drift Change",
          "description": "• Guide the crane to move the drift out of the machine.\n• Release the magnetic yoke pin once the drift is properly supported."
        },
        {
          "id": "hHsS2RzwxUO14SHBCEL9",
          "title": "Safety Precautions",
          "order": 1,
          "toolIds": [],
          "partIds": [],
          "description": "• Engage the black Emergency Stop (E-Stop) for Zone 3.1 and Zone 3C.\n• On the Touchscreen Panel, go to Main → Gate and unlock the door by pressing T.LOCK.14.\n• Manually open the gate.",
          "imageUrls": [
            "http://172.20.10.2:3001/uploads/1764160653386-692471565.jpeg",
            "http://172.20.10.2:3001/uploads/1764160653393-982368039.png",
            "http://172.20.10.2:3001/uploads/1764160653404-285809161.png",
            "http://172.20.10.2:3001/uploads/1764160653414-703608158.png",
            "http://172.20.10.2:3001/uploads/1764160653420-183166722.png"
          ]
        },
        {
          "id": "hVu0DjqAT8JYbG5F7NyK",
          "imageUrls": [
            "http://172.20.10.2:3001/uploads/1764325946924-422345654",
            "http://172.20.10.2:3001/uploads/1764325946935-945145484.png",
            "http://172.20.10.2:3001/uploads/1764325946945-239464715.png",
            "http://172.20.10.2:3001/uploads/1764325946959-581807058.png"
          ],
          "partIds": [
            "Fyjib95MSn9EVomsU7fx"
          ],
          "toolIds": [],
          "title": "Installation of New Jaws",
          "order": 6,
          "description": "• With the assistance of a helper, place each jaw into the jaw base.\n• Insert and tighten all bolts securely.\n• Repeat the process for all jaws.\n• Using a spanner, ensure all bolts are properly tightened.\n• Adjust the jaw height as per the reference manual."
        },
        {
          "id": "kDnFpRFw6xmJbiOADpts",
          "imageUrls": [
            "http://172.20.10.2:3001/uploads/1764160663807-70176070.png",
            "http://172.20.10.2:3001/uploads/1764160663818-692825980.jpeg",
            "http://172.20.10.2:3001/uploads/1764160663826-634103419.png"
          ],
          "title": "Change Operating Mode",
          "toolIds": [],
          "partIds": [],
          "description": "• On the in-line control panel, switch Zone 3.1 and Zone 3C from AUTO to MANUAL.\n• Navigate to Section 3C on the Touch Panel and stop the Buck-on Pump.",
          "order": 0
        },
        {
          "id": "nWZnpCsXyRg6anXOR2m4",
          "order": 2,
          "toolIds": [],
          "partIds": [],
          "imageUrls": [
            "http://172.20.10.2:3001/uploads/1764325604618-635210186",
            "http://172.20.10.2:3001/uploads/1764325604639-591637905.png"
          ],
          "description": "• Loosen the screws of the jaw lockers using a 6mm Allen key.\n• Once loosened, completely remove the bolts and slide out the jaw from the base.\n• Repeat the process for all positions in both the Rotary Head and Back Tong.",
          "title": "Removal of Jaws"
        },
        {
          "id": "psdrLr4GbxpwWLWJZZV3",
          "title": "Mechanical Adjustments",
          "toolIds": [],
          "imageUrls": [
            "http://172.20.10.2:3001/uploads/1764325827155-169628436",
            "http://172.20.10.2:3001/uploads/1764325827166-397776025"
          ],
          "partIds": [],
          "description": "Ensure the rotary head is fully open (0° crank angle) before adjusting.\nInsert a 12mm Allen wrench into the jaw guide and adjust by turning clockwise or\ncounterclockwise.\nVerify the settings using the scale at each jaw guide.",
          "order": 5
        },
        {
          "id": "qHYFGPECzuoq5LuDfKh7",
          "imageUrls": [
            "http://172.20.10.2:3001/uploads/1764325690411-427846831",
            "http://172.20.10.2:3001/uploads/1764325690421-766761809"
          ],
          "toolIds": [],
          "description": "• Use support of helper to transfer Jaws.\n• Clean the Bases of all Jaws.",
          "order": 3,
          "title": "Cleaning",
          "partIds": []
        },
        {
          "id": "yO93ZESxfzsNfKPlcM10",
          "imageUrls": [
            "http://172.20.10.2:3001/uploads/1764326204118-734165258",
            "http://172.20.10.2:3001/uploads/1764326204130-675515356",
            "http://172.20.10.2:3001/uploads/1764326204137-112174636",
            "http://172.20.10.2:3001/uploads/1764326204143-283103462.png",
            "http://172.20.10.2:3001/uploads/1764326204149-75504813.png",
            "http://172.20.10.2:3001/uploads/1764326204156-924294080.png",
            "http://172.20.10.2:3001/uploads/1764326204166-988084079"
          ],
          "toolIds": [],
          "order": 8,
          "description": "Remove the Old Drift:\n• Unscrew the bolt securing the drift.\n• Use a crane (ensure operator certification and inspection before use).\n• Attach the magnetic yoke to the drift and conduct a validation lift (30cm above\nthe drift table) to confirm a secure hold.",
          "title": "Drift Change",
          "partIds": []
        }
      ]
    }
